# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Set to "true" on preview/dev deployments to enable the @test.local test
# credentials provider. Leave unset or "false" on production.
# IS_PREVIEW=

# Shared HMAC secret used to verify SSO tokens from Central Manager.
# Required on production; ops supplies this at deploy time.
# SSO_SHARED_SECRET=

# Self-hosted SMTP settings for email verification / password reset.
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  SMTP_FROM=

# Public dashboard origin used in Slack alert links (convex/syncAlerts.ts).
# APP_URL=

# Origin of the server-management component (credential hub) this app calls.
# VITE_SERVER_MANAGEMENT_URL=

# Origin of the wp-updates-dashboard component (linked from SiteDetailPage.tsx).
# VITE_WP_UPDATES_URL=